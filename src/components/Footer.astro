---
import { email, mailHref, person, studio } from '../data/site';

const year = new Date().getFullYear();
const links = [
  { href: '/pricing', label: 'Pricing' },
  { href: '/about', label: 'About' },
  { href: '/contact', label: 'Contact' },
  { href: '/privacy', label: 'Privacy' },
  { href: '/web-design-milton-keynes', label: 'Milton Keynes' },
  { href: '/web-design-bedfordshire', label: 'Bedfordshire' },
];
---

<footer class="site-footer">
  <div class="wrap footer-grid">
    <div class="stack">
      <p class="footer-name">{studio}</p>
      <p>{person}</p>
      <p>Web design for small businesses in Milton Keynes and Bedfordshire.</p>
      <p><a href={mailHref()}>{email}</a></p>
    </div>
    <nav aria-label="Footer">
      <ul class="footer-links">
        {links.map((link) => (
          <li><a href={link.href}>{link.label}</a></li>
        ))}
      </ul>
    </nav>
  </div>
  <div class="wrap footer-base">
    <p>© {year} {studio}. {person}.</p>
  </div>
</footer>
