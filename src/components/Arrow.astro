---
interface Props {
  dir?: 'down' | 'right';
}
const { dir = 'down' } = Astro.props;
---

<span class="arrow" aria-hidden="true">
  {
    dir === 'down' ? (
      <svg viewBox="0 0 16 16" width="14" height="14">
        <path d="M3.5 6.5 8 11l4.5-4.5" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round" />
      </svg>
    ) : (
      <svg viewBox="0 0 16 16" width="14" height="14">
        <path d="M6 3.5 10.5 8 6 12.5" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round" />
      </svg>
    )
  }
</span>
