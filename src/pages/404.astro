---
import PageHero from '../components/PageHero.astro';
import { mailHref } from '../data/site';
import BaseLayout from '../layouts/BaseLayout.astro';
import { pageGraph } from '../lib/schema';

const title = 'Page not found | CreativeMKStudios';
const description = 'This page is not on the CreativeMKStudios website.';
const site = Astro.site ?? new URL('https://creativemkstudios.co.uk');
const schema = pageGraph({ site, path: '/404', title, description });
---

<BaseLayout title={title} description={description} schema={schema} robots="noindex, follow">
  <PageHero
    crumbs={[
      { href: '/', label: 'Home' },
      { label: 'Page not found' },
    ]}
    title="This page"
    accent="is not here"
    lede="The link may be old, or the address may be typed wrong. You can go back to the homepage, see pricing, or email me."
  />
  <section class="section">
    <div class="wrap" style="display: flex; flex-wrap: wrap; gap: 1rem 1.5rem; align-items: center;">
      <a class="pill" href="/">
        Back home
        <span class="arrow" aria-hidden="true">
          <svg viewBox="0 0 16 16" width="14" height="14">
            <path d="M6 3.5 10.5 8 6 12.5" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round" />
          </svg>
        </span>
      </a>
      <a class="text-link" href="/pricing">See pricing</a>
      <a class="text-link" href={mailHref()}>Email me</a>
    </div>
  </section>
</BaseLayout>
